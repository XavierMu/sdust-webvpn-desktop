{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SDUST WebVPN",
  "version": "0.3.0",
  "identifier": "cn.edu.sdust.webvpn.local",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "SDUST WebVPN 本地代理",
        "width": 1020,
        "height": 700,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src http://127.0.0.1:8897"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "shortDescription": "SDUST WebVPN 本地透明代理",
    "longDescription": "让浏览器、git、pip、npm 等直接用校内原始地址访问学校资源。"
  }
}
